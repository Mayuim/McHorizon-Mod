{
	"schemaVersion": 1,
	"id": "mchorizon",
	"version": "${version}",
	"name": "MCHorizons",
	"description": "Required client mod for MC Horizons: real first-person paint guns held in your own skin's arms, with aim down sights, recoil and reload animations.",
	"authors": [
		"Mayuim"
	],
	"contact": {
		"homepage": "https://github.com/Mayuim/McHorizon-Mod"
	},
	"license": "MIT",
	"icon": "assets/mchorizon/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.mchorizon.HorizonClient"
		]
	},
	"depends": {
		"fabricloader": ">=0.17.3",
		"minecraft": "1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	},
	"mixins": [
		"mchorizon.mixins.json"
	]
}
